# Скопируй в .env и заполни. Без ключей конвейер не поедет.

# ---------- kie.ai (тексты, зрение, редроу, видео) ----------
# Взять: kie.ai → Ключи API
KIE_API_KEY=

# Через kie.ai. Anthropic на kie часто лагает.
LLM_MODEL=gemini-3-pro
LLM_FALLBACK_MODELS=gemini-2.5-pro,gemini-3-flash

# Мастер-кадр 3x3. Для кириллицы нужен 4K.
KIE_IMAGE_MODEL=gpt-image-2-text-to-image

# Живая обложка (6 сек). 1 = делать, 0 = первый слайд картинкой.
KIE_VIDEO_MODEL=grok-imagine/image-to-video
LIVE_COVER=0

# ---------- Pinterest (референсы, оригиналы не постим) ----------
# Экспорт кук расширением «Get cookies.txt LOCALLY».
PINTEREST_COOKIES_FILE=secrets/pinterest_cookies.txt
PINS_PER_RUN=8
# Для пина через Zernio почти всегда нужен boardId (GET /accounts/{id}/pinterest-boards)
PINTEREST_BOARD_ID=
PINTEREST_LINK=

# ---------- Zernio (публикация) ----------
# Ключ: кабинет zernio → Settings → API Keys. Формат sk_ + 64 hex.
ZERNIO_API_KEY=

# Цели: platform:accountId через запятую.
# ID аккаунтов: GET https://zernio.com/api/v1/accounts
# Для РФ логичный старт: telegram + pinterest / youtube / tiktok.
# Instagram опционален (аккаунт ещё жив). MAX и VK в Zernio нет.
# Примеры:
#   ZERNIO_TARGETS=telegram:YOUR_TG_ACCOUNT_ID
#   ZERNIO_TARGETS=telegram:ID1,youtube:ID2,tiktok:ID3
#   ZERNIO_TARGETS=telegram:ID1,instagram:ID2
ZERNIO_TARGETS=

# Старое имя, если не хочется трогать ZERNIO_TARGETS: один Instagram-аккаунт.
ZERNIO_INSTAGRAM_ACCOUNT_ID=

ZERNIO_API_URL=https://zernio.com/api/v1

# ---------- Режим ----------
# 0 = собрать и ждать кнопку в Telegram
# 1 = постить сразу после QA, без человека
AUTO_PUBLISH=0

# Кодовое слово CTA на 9-м слайде и в подписи (пиши СТАРТ в директ / комментарий).
CTA_WORD=СТАРТ
SERIES_NAME=КАРУСЕЛЬ

# ---------- Telegram HITL ----------
# Токен от @BotFather. Каждый получатель один раз жмёт Start у бота.
TG_BOT_TOKEN=
# ID чатов через запятую (@userinfobot).
TG_CHAT_IDS=
# Кто жмёт «Опубликовать». Пусто = любой из TG_CHAT_IDS.
TG_PUBLISH_CHAT_ID=

EXTRA_RUNS_PER_DAY=3

# ---------- Техническое ----------
# В Docker уже /usr/bin/chromium. На хосте: google-chrome или chromium.
CHROME_BIN=/usr/bin/chromium
KEEP_RUNS_DAYS=14
